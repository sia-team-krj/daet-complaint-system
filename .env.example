APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Proxies whose X-Forwarded-* headers may be trusted. Tailscale serve terminates
# TLS and forwards over plain HTTP, so the app must trust it to know the browser
# is really on https. '*' is fine on a private network; narrow it to the proxy
# address if this is ever exposed publicly.
TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@daetlistens.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo API for OTP and password reset delivery
BREVO_API_KEY=
BREVO_FROM_EMAIL="noreply@daetlistens.gov.ph"
BREVO_FROM_NAME="${APP_NAME}"

# Email OTP verification
EMAIL_OTP_EXPIRES_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
# Ceiling on top of the resend cooldown, so one account cannot request an
# unbounded number of codes even by waiting out each cooldown.
EMAIL_OTP_RESEND_MAX_PER_HOUR=10

# Staff invitation links (single use, locked to the invited address)
INVITATION_EXPIRES_IN_HOURS=24

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional MinIO-specific overrides for the complaint evidence disk
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_DEFAULT_REGION=us-east-1
MINIO_BUCKET=local
MINIO_ENDPOINT=http://127.0.0.1:9000

VITE_APP_NAME="${APP_NAME}"
